{
    "require": {
        "nikic/php-parser": "^5.7",
        "symfony/console": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/process": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "phploc/phploc": "^7.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ProjectDossier\\": "src/bin/"
        }
    },
    "bin": ["src/bin"],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
